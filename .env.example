# Canonical URL of this marketing site (used for metadata, sitemap, robots and JSON-LD).
NEXT_PUBLIC_SITE_URL=https://kanso.example.com

# The kanso web app (kanso-frontend). Sign-in and sign-up links point here.
NEXT_PUBLIC_APP_URL=https://kanso-web-app.vercel.app

# Where "Try the demo" sends people. Defaults to the app's signup page, which has the demo button.
# If you add a route in kanso-frontend that starts the demo directly, point this at it.
NEXT_PUBLIC_DEMO_URL=https://kanso-web-app.vercel.app/signup
